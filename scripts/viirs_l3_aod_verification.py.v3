def crop_model_boundaries(model):
    """Returns the (west, east, south, north) box in degrees to crop a model/VIIRS pair to."""
    match model:
        case "HRRR-Smoke":
            return -140.0, -50.0, 15.0, 55.0

        case "MPAS-Aerosols":
            return -160.0, -40.0, 10.0, 90.0

        case "RAP-Smoke":
            return -180.0, 180.0, -20.0, 90.0

        case _:
            return -180.0, 180.0, 0.0, 90.0

def crop_slice(coord, lo, hi):
    """Returns the contiguous slice selecting a monotonic 1D coordinate's values within [lo, hi]."""
    idx = np.flatnonzero((coord >= lo) & (coord <= hi))
    if idx.size == 0:
        raise ValueError(f"No coordinates found within [{lo}, {hi}]")
    return slice(idx[0], idx[-1] + 1)

def load_map_regions(csv_path):
    """Reads lambert_map_settings.csv into {region: {'ps': [cen_lat, cen_lon], 'axl': [x1, x2, y1, y2], 'mapres': str}}."""
    regions = {}
    with open(csv_path, newline='') as f:
        for row in csv.DictReader(f):
            regions[row['region']] = {
                'ps': [float(row['cen_lat']), float(row['cen_lon'])],
                'axl': [float(row['x1']), float(row['x2']), float(row['y1']), float(row['y2'])],
                'mapres': row['MapRes'],
            }
    return regions

def region_rows(region, map_regions):
    """Builds the (label, ps, axl, mapres) row list for a map figure: NA+CONUS (2 rows) for
    region == "CONUS" to match the existing figure, a single row for every other region."""
    if region == "CONUS":
        na, conus = map_regions["North_America"], map_regions["CONUS"]
        return [("NA", na['ps'], na['axl'], na['mapres']),
                ("CONUS", conus['ps'], conus['axl'], conus['mapres'])]
    r = map_regions[region]
    return [(region, r['ps'], r['axl'], r['mapres'])]

def fractional_hour_to_datetime(t, base_date):
    """Converts fractional hours to a datetime object."""
    if not np.isfinite(t) or t < 0:
        return datetime(1900, 1, 1)
    return base_date + timedelta(milliseconds=int(round(t * 60 * 60 * 1000)))

def is_valid_file(filepath):
    """Returns True if filepath points to a real, usable file (i.e. not "None"/empty/missing)."""
    return bool(filepath) and filepath.lower() != "none" and os.path.isfile(filepath)

def build_viirs_label(viirs_files):
    """Builds a label like 'VIIRS (NOAA20/NOAA21)' from the products with a valid input file."""
    viirs_display_names = {'snpp': 'SNPP', 'noaa20': 'NOAA20', 'noaa21': 'NOAA21'}
    available = [viirs_display_names[name] for name in viirs_display_names if is_valid_file(viirs_files.get(name))]
    return f"VIIRS ({'/'.join(available)})" if available else 'VIIRS'

def viirs_file_date(filepath, fallback_time):
    """Extracts the date from the VIIRS filename or falls back to initial time."""
    filename = os.path.basename(filepath)
    match = re.search(r'_(\d{8})(?:_[^.]+)?\.nc$', filename)
    if not match:
        return fallback_time.replace(hour=0, minute=0, second=0, microsecond=0)
    return datetime.strptime(match.group(1), "%Y%m%d")

def read_model_data(filepath, bounds):
    """Reads model data from a NetCDF file, cropped to a (west, east, south, north) box in degrees."""
    west, east, south, north = bounds
    with nc.Dataset(filepath, 'r') as ds:
        time_vals = ds.variables['time'][:]
        # Convert unix seconds to datetime
        times = np.array([datetime.fromtimestamp(t) for t in time_vals])

        lon_all = ds.variables['lon'][:]
        lat_all = ds.variables['lat'][:]
        lon_sl = crop_slice(lon_all, west, east)
        lat_sl = crop_slice(lat_all, south, north)

        aod = ds.variables['AOD550'][:, lat_sl, lon_sl]

        # Some models report AOD as exactly zero everywhere at the first
        # time step (spin-up artifact). Left as-is, this drags the model
        # mean down and biases it low against VIIRS, so flag it as missing.
        if aod.shape[0] > 0 and np.nansum(aod[0]) == 0:
            es.msg("  First model time step has zero AOD everywhere, setting to NaN")
            aod[0] = np.nan

        return {
            'lon': lon_all[lon_sl],
            'lat': lat_all[lat_sl],
            'time': times,
            'aod': aod
        }

def replace_bad_viirs_aod(aod):
    """Replaces invalid or negative AOD values with NaN."""
    aod[~np.isfinite(aod) | (aod < 0)] = np.nan
    return aod

def read_viirs_netcdf(filepath, initial_time, bounds):
    """Reads VIIRS NetCDF, cropped to a (west, east, south, north) box in degrees."""
    base_date = viirs_file_date(filepath, initial_time)
    west, east, south, north = bounds

    with nc.Dataset(filepath, 'r') as ds:
        lon_all = ds.variables['lon'][:]
        lat_all = ds.variables['lat'][:]
        lon_sl = crop_slice(lon_all, west, east)
        lat_sl = crop_slice(lat_all, south, north)

        aod = ds.variables['AOD550'][lat_sl, lon_sl]
        aod = replace_bad_viirs_aod(aod)

        # Convert fractional UTC hours manually
        overpass_time = ds.variables['overpass_time'][lat_sl, lon_sl]
        v_frac_to_dt = np.vectorize(lambda t: fractional_hour_to_datetime(t, base_date))
        times = v_frac_to_dt(overpass_time)

        return {
            'lon': lon_all[lon_sl],
            'lat': lat_all[lat_sl],
            'time': times,
            'aod': aod
        }

def average_aod(*arrays):
    """Averages any number of AOD arrays, handling NaNs gracefully."""
    finite_masks = [np.isfinite(a) for a in arrays]
    count = sum(m.astype(np.int8) for m in finite_masks)
    total = sum(np.where(m, a, 0.0) for m, a in zip(finite_masks, arrays))
    return np.divide(total, count, out=np.full(arrays[0].shape, np.nan, dtype=float), where=count > 0)

def write_output_netcdf(filepath, lon, lat, model_mean, viirs_mean):
    """Writes the processed time-mean data to a NetCDF4 file."""
    with nc.Dataset(filepath, "w", format="NETCDF4") as ds:
        ds.createDimension("lon", len(lon))
        ds.createDimension("lat", len(lat))
        
        var_lon = ds.createVariable("lon", "f4", ("lon",))
        var_lon.long_name = "longitude"
        var_lon.units = "degrees_east"
        var_lon[:] = lon
        
        var_lat = ds.createVariable("lat", "f4", ("lat",))
        var_lat.long_name = "latitude"
        var_lat.units = "degrees_north"
        var_lat[:] = lat
        
        with warnings.catch_warnings():
            warnings.filterwarnings(
                "ignore",
                message="Setting the shape on a NumPy array has been deprecated.*",
                category=DeprecationWarning,
            )
            
            var_mod = ds.createVariable("aod_model", "f4", ("lat", "lon"), zlib=True, complevel=3, fill_value=np.nan)
            var_mod.long_name = "time-mean model aerosol optical depth"
            var_mod[:, :] = np.asarray(model_mean, dtype=np.float32)
            
            var_obs = ds.createVariable("aod_viirs", "f4", ("lat", "lon"), zlib=True, complevel=3, fill_value=np.nan)
            var_obs.long_name = "time-mean VIIRS aerosol optical depth"
            var_obs[:, :] = np.asarray(viirs_mean, dtype=np.float32)

def read_output_netcdf(filepath):
    """Reads back a per-model time-mean NetCDF file written by write_output_netcdf.
    The data was already cropped to the model's domain at save time (see crop_model_boundaries),
    so no further cropping is needed here."""
    with nc.Dataset(filepath, 'r') as ds:
        return {
            'lon': ds.variables['lon'][:],
            'lat': ds.variables['lat'][:],
            'aod_model': ds.variables['aod_model'][:],
            'aod_viirs': ds.variables['aod_viirs'][:],
        }

def get_metrics(lon, lat, obs, model, origin, axlims):
    """Computes metrics over the pixels actually visible in a plot panel.
    origin: Lambert projection specs for that row (the same Origin passed to es.spatial).
    axlims: [xmin, xmax, ymin, ymax] in projected km for that row (its axl)."""
    lon2d, lat2d = np.meshgrid(lon, lat) #, indexing='ij')
    x, y = ll2lamb(lat2d, lon2d, origin)
    x_f, y_f, lat_f = x.ravel(), y.ravel(), lat2d.ravel()
    obs_f, model_f = obs.ravel(), model.ravel()

    mask = (x_f >= axlims[0]) & (x_f <= axlims[1]) & (y_f >= axlims[2]) & (y_f <= axlims[3])

    return es.metrics(obs_f[mask], model_f[mask], np.cos(np.radians(lat_f[mask])), metrics_to_show=["R", "MB", "cRMSE"], num_format='.3f')
    
def _finalize_grid(axes, axl, ncols):
    """Shared axis-limit/tick cleanup and layout pass for a 2-row multi-column figure."""
    nrows = len(axes)
    for row in range(nrows):
        for ax in axes[row]:
            ax.set_xlim(axl[row][0], axl[row][1])
            ax.set_ylim(axl[row][2], axl[row][3])
            ax.set_xticks([])
            ax.set_yticks([])

    es.reorganizeaxes(nrows, ncols, width=300, height=None, spacing_horiz=10, spacing_vert=10,
                       remove_tick_labels=True, margin=120)

def _finalize_colorbar(cb, nrows, ncols, rotate_labels=False):
    """Shared colorbar repositioning/tick cleanup, stretched across the full row width."""
    cb = es.reorganizecolorbar(cb, nrows, ncols, 'bottom', proportion=0.96, extent_axes=[1, ncols])
    cb.ax.tick_params(labelsize=9.5)

    x0, y0, w, _ = cb.ax.get_position().bounds
    cb.ax.set_position([x0, y0, w, 0.02])

    cb_ticks = cb.get_ticks()[1:-1]
    cb_labels = [t.get_text() for t in cb.ax.get_xticklabels()][1:-1]
    cb.set_ticks(cb_ticks)
    cb.set_ticklabels(cb_labels)
    if rotate_labels:
        plt.setp(cb.ax.get_xticklabels(), rotation=90)
    return cb

def make_spatial_figure(columns, rows, lev_aod, cmap_aod, initial_time, end_time, viirs_label):
    """Spatial AOD comparison. columns: list of (label, lon, lat, field) tuples, column 0 is VIIRS.
    Each column may have its own lon/lat grid, since models can be cropped to different domains.
    rows: list of (label, ps, axl, mapres) tuples, one per map row -- e.g. NA+CONUS for the CONUS
    figure, or a single region for everything else."""
    ncols = len(columns)
    nrows = len(rows)

    axes = [[None] * ncols for _ in range(nrows)]
    ids = []
    cb = None

    for row, (row_label, row_ps, row_axl, row_mapres) in enumerate(rows):
        for col, (name, lon, lat, field) in enumerate(columns):
            es.msg(f"{row_label} {name} AOD")
            ax = plt.subplot(nrows, ncols, row * ncols + col + 1)
            axes[row][col] = ax

            if col == 0:
                es.spatial(lon, lat, field, Projection='lambert', Origin=row_ps, Levels=lev_aod,
                           MapRes=row_mapres, Colormap=cmap_aod, GeoTicks='off', Colorbar='off', MapWidth=0.3)
            elif cb is None:
                cb, _ = es.spatial(lon, lat, field, Projection='lambert', Origin=row_ps, Levels=lev_aod,
                                    MapRes=row_mapres, Colormap=cmap_aod, GeoTicks='off', MapWidth=0.3)
            else:
                es.spatial(lon, lat, field, Projection='lambert', Origin=row_ps, Levels=lev_aod,
                           MapRes=row_mapres, Colormap=cmap_aod, GeoTicks='off', Colorbar='off', MapWidth=0.3)

            if row == 0:
                ids.append(es.figid(f'{name}', ax=ax, FontName="Nimbus Sans"))

    _finalize_grid(axes, [r[2] for r in rows], ncols)
    cb = _finalize_colorbar(cb, nrows, ncols)
    plt.setp(ids, fontsize=11)

    stime1 = initial_time.strftime("%Y-%m-%d %H")
    stime2 = end_time.strftime("%Y-%m-%d %H")
    label_str = f"{viirs_label} AOD 550 nm between {stime1}Z and {stime2}Z"
    axes[0][0].text(0, 1.2, label_str, fontsize=9, transform=axes[0][0].transAxes, family="Nimbus Sans", color=(0.5, 0.5, 0.5))

def make_bias_figure(columns, M, rows, lev_bias, cmap_bias, initial_time, end_time, viirs_label):
    """Bias (model - VIIRS) comparison. columns: list of (label, lon, lat, field) tuples, one per model.
    Each column may have its own lon/lat grid, since models can be cropped to different domains.
    rows: list of (label, ps, axl, mapres) tuples, one per map row -- e.g. NA+CONUS for the CONUS
    figure, or a single region for everything else.
    M[i][row] holds the metrics for model i over the pixels shown in that row's panel (see get_metrics)."""
    ncols = len(columns)
    nrows = len(rows)

    axes = [[None] * ncols for _ in range(nrows)]
    ids = []
    mms = []
    cb = None

    for row, (row_label, row_ps, row_axl, row_mapres) in enumerate(rows):
        for col, (name, lon, lat, field) in enumerate(columns):
            es.msg(f"{row_label} {name} Bias")
            ax = plt.subplot(nrows, ncols, row * ncols + col + 1)
            axes[row][col] = ax

            if cb is None:
                cb, _ = es.spatial(lon, lat, field, Projection='lambert', Origin=row_ps, Levels=lev_bias,
                                    MapRes=row_mapres, Colormap=cmap_bias, GeoTicks='off', MapWidth=0.3)
            else:
                es.spatial(lon, lat, field, Projection='lambert', Origin=row_ps, Levels=lev_bias,
                           MapRes=row_mapres, Colormap=cmap_bias, GeoTicks='off', Colorbar='off', MapWidth=0.3)

            if row == 0:
                # ids.append(es.figid(f'Bias: {name} - VIIRS', ax=ax, FontName="Nimbus Sans"))
                ids.append(es.figid(f"{name} bias", ax=ax, FontName="Nimbus Sans"))
            # mms.append(ax.text(0.02, 0.01, '\n'.join(M[col][row].Text[2:]), va='bottom', transform=ax.transAxes))
            # mms.append(ax.text(0.02, 0.01, '\n'.join(M[col][row].Text), va='bottom', transform=ax.transAxes, family="Nimbus Mono PS"))
            mms.append(es.figid('\n'.join(M[col][row].Text), Location='outright', FontName="Nimbus Mono PS"))
            ax.set_facecolor((0.8, 0.8, 0.8))

    _finalize_grid(axes, [r[2] for r in rows], ncols)
    cb = _finalize_colorbar(cb, nrows, ncols, rotate_labels=False)
    plt.setp(ids, fontsize=11)
    plt.setp(mms, fontsize=6)

    stime1 = initial_time.strftime("%Y-%m-%d %H")
    stime2 = end_time.strftime("%Y-%m-%d %H")
    label_str = f"AOD 550 nm bias against {viirs_label} between {stime1}Z and {stime2}Z"
    axes[0][0].text(0, 1.2, label_str, fontsize=9, transform=axes[0][0].transAxes, family="Nimbus Sans", color=(0.5, 0.5, 0.5))


