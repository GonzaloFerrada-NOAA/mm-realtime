        nan_value: -1.0 # Set this value to NaN
        ylabel_plot: 'SO2 (ppbv)' #Optional to set ylabel so can include units and/or instr etc.
EOF
fi
###################################################################################################################
if [[ "${species}" == "NO" ]]; then
cat << EOF >> ${YAML}
