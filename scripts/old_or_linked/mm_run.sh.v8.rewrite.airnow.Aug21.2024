#!/bin/bash
#
set -x
# Define some initial variables to set up the variable names
#
species=${SPECIES_TO_VERIFY}
platform=${OBS_PLATFORM}
sat_platforms=("MODIS_AQUA" "MODIS_TERRA" "TROPOMI" "GOES-R")
#
workdir=${WORKDIR}
#
mkdir -p ${workdir}
cd ${workdir}
#-------------------------------------------------------------------------------------
# Intital checks to see if we should proceed
if [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then
      if [[ "${plot_type}" -ne "spatial_bias" ]]; then
        echo "Satellite plots only produced for gridded spatial bias, exiting"
        exit 0
      fi
fi
#-------------------------------------------------------------------------------------
#
output_directory=${PLOT_OUTPUT_DIR}
mkdir -p ${output_directory}
#
scriptsdir=${SCRIPTS_DIR}
if [[ "${sat_platforms[*]}" =~ "${platform}" ]] || [[ "${plot_type}" == "csi" ]]; then
  source /mnt/lfs5/BMC/rtwbl/rap-chem/miniconda/bin/activate melodies-monet-sat 
else
  source ${CONDA_DIR} ${CONDA_ENV}
fi
#
#-------------------------------------------------------------------------------------
# Load any required module
module load nco
#
DATE=/bin/date
#Set up the date strings
todays_date=${START_TIME}
#
# Today variables 
YYYY_today=`${DATE} +%Y -d "${todays_date}"`
MM_today=`${DATE} +%m -d "${todays_date}"`
DD_today=`${DATE} +%d -d "${todays_date}"`
HH_today=`${DATE} +%H -d "${todays_date}"`
#
# Yesterday Variables
YYYY_ytday=`${DATE} +%Y -d "${todays_date} - 24 hours"`
MM_ytday=`${DATE} +%m -d "${todays_date} - 24 hours"`
DD_ytday=`${DATE} +%d -d "${todays_date} - 24 hours"`
#
# Tomorrow variables
YYYY_tomorrow=`${DATE} +%Y -d "${todays_date} + 24 hours"`
MM_tomorrow=`${DATE} +%m -d "${todays_date} + 24 hours"`
DD_tomorrow=`${DATE} +%d -d "${todays_date} + 24 hours"`
#
YYYY_twodays=`${DATE} +%Y -d "${todays_date} + 48 hours"`
MM_twodays=`${DATE} +%m -d "${todays_date} + 48 hours"`
DD_twodays=`${DATE} +%d -d "${todays_date} + 48 hours"`
#
# start/end time is for yesterday, day N-1
start_time_yaml=${YYYY_ytday}-${MM_ytday}-${DD_ytday}-00:00:00
end_time_yaml=${YYYY_today}-${MM_tomorrow}-${DD_tomorrow}-00:00:00
#
#
#-------------------------------------------------------------------------------------
# .. Other namelist
tol_hours_missing=0  #tolerance threshold for number of hours acceptable to be missing 
mdl_lw=1.5
#
# Remove any old files
rm -f tmp*
#
# Copy the namelist and set up the lists
cp ${scriptsdir}/${namelist} ./monet_namelist
file="./monet_namelist"
    listmodel=()
    listtype=()
    listnt=()   # use for init/run length/relative day/color/marker/linestyle
    listmodvar=()
    listobsvar=()
    listspecies=() 
    list_touse=()
sed 1d $file | while IFS=, read -r model_name model_type init run_len relative_day color marker linestyle rawspecies
do
    ###############################################################
    listmodel+=($model_name)
    echo "JLS, listmodel = ${listmodel[*]}"
    ###############################################################
    listtype+=($model_type)
    ###############################################################
    nt=$(echo "$init" | awk -F "/" '{print NF-1}')
    ntime=$(echo "$nt" \+ 1 | bc)
    listnt+=($ntime)
    listinit=()
    for ((i=1; i<=ntime; i++)); do 
    subinit=$(echo $init| cut -d'/' -f $i)
    listinit+=($subinit)
    done
    ###############################################################
    listrunlen=()
    for ((i=1; i<=ntime; i++)); do 
    subrun_len=$(echo $run_len| cut -d'/' -f $i)
    listrunlen+=($subrun_len)
    done
    ###############################################################
    listrelday=()
    for ((i=1; i<=ntime; i++)); do 
    subrel_day=$(echo $relative_day| cut -d'/' -f $i)
    listrelday+=($subrel_day)
    done
    ###############################################################
    listcolor=()
    for ((i=1; i<=ntime; i++)); do 
    subcolor=$(echo $color| cut -d'/' -f $i)
    listcolor+=($subcolor)
    done
    ###############################################################
    listmarker=()
    for ((i=1; i<=ntime; i++)); do 
    submarker=$(echo $marker| cut -d'/' -f $i)
    listmarker+=($submarker)
    done
    ###############################################################
    listlinestyle=()
    for ((i=1; i<=ntime; i++)); do 
    sublinestyle=$(echo $linestyle| cut -d'/' -f $i)
    listlinestyle+=($sublinestyle)
    done
    ###############################################################
    allspecies=$(echo "$rawspecies" | awk '{gsub(/:/,"/")}1')
    ns=$(echo "$allspecies" | awk -F "/" '{print NF-1}')
    nspecies2=$(echo "$ns" \+ 1 | bc)
    nspecies=$(echo "$nspecies2" \/ 2 | bc)
    listspecies+=($nspecies)
    printf "species: %s\n" "$rawspecies"
    for ((i=2; i<=nspecies2; i+=2)); do
    iminus=$(expr $i - 1)
    submodvar=$(echo $allspecies| cut -d'/' -f $iminus)
    listmodvar+=($submodvar)
    subobsvar=$(echo $allspecies| cut -d'/' -f $i)
    listobsvar+=($subobsvar)
    list_touse=($ntime $model_name $model_type ${listinit[*]} ${listrunlen[*]} ${listrelday[*]} ${listcolor[*]} ${listmarker[*]} ${listlinestyle[*]} $submodvar $subobsvar)
    echo ${list_touse[*]} >> tmp_list.${subobsvar}
    done
    species=$(echo $rawspecies | tr '/' ' ')
    echo "Model Name: $model_name Model Type: $model_type Initial Times: ${listinit[*]} Run Length: ${listrunlen[*]} Relative Day to Obs: ${listrelday[*]} Marker Color: ${listcolor[*]} Marker Shape: ${listmarker[*]} Line Style: ${listlinestyle[*]} Species: $species"
done #read file
#
#-------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------
# Set up which domains will be plotted
echo "Now working on analysis for $species"
# Start with all regions/sites defined
CONUS=1; R1=1; R2=1; R3=1; R4=1; R5=1; R6=1; R7=1; R8=1; R9=1; R10=1; site=0; do_stats=0; np=11; nsite=0
#
if [[ "${plot_type}" == "stats" ]]; then
  do_stats=1
fi
#
if [[ "${plot_type}" == "ts_site" ]]; then
  # Turn off regions and turn on sites for site plots
  CONUS=0; R1=0; R2=0; R3=0; R4=0; R5=0; R6=0; R7=0; R8=0; R9=0; R10=0; site=1
fi
#
if [[ "${species}" == "PM10" ]]; then
  R2=0; R3=0; np=9
fi
#
if [[ "${species}" == "NO2" ]]; then
  R1=0; R4=0; R6=0; R7=0; R8=0; R10=0; np=5
fi
#
if [[ "${species}" == "CO" ]]; then
  R1=0; R2=0; R4=0;  R6=0; R7=0; R8=0; R10=0; np=4
fi
#----------------------------------------------
if [[ ${platform} == "aeronet" ]] || \
   [[ ${platform} == "airnow" ]] || \
   [[ ${platform} == "ish" ]] || \
   [[ ${platform} == "ish-lite" ]] || \
   [[ ${platform} == "openaq" ]]; then
   ts_select_time="'time'"
   if [[ -e ${OBS_DIR}/test5.${platform}.${todays_date}.nc ]]; then
     ln -sf ${OBS_DIR}/test5.${platform}.${todays_date}.nc test5.nc
   else
     echo "NO ${platform} DATA, exiting"
     exit 0
   fi
elif [[ "${platform}" == "MODIS_AQUA" ]]; then
   numfilecheck=`ls ${OBS_DIR}/MY* | wc -l`
   if [[ ${numfilecheck} -gt ${tol_hours_missing} ]];then
      ln -s ${OBS_DIR}/MYD04* .
   else 
      echo "NO MODIS AQUA files, exiting"
      exit 0
   fi
elif [[ "${platform}" == "MODIS_TERRA" ]]; then
   numfilecheck=`ls ${OBS_DIR}/MO* | wc -l`
   if [[ ${numfilecheck} -gt ${tol_hours_missing} ]];then
      ln -s ${OBS_DIR}/MOD04* .
   else
      echo "NO MODIS TERRA files, exiting"
      exit 0
   fi
elif [[ "${platform}" == "TROPOMI" ]];then
   numfilecheck=`ls ${OBS_DIR}/S5P_NRTI_L2__${species}_* | wc -l`
   if [[ ${numfilecheck} -gt ${tol_hours_missing} ]];then
      ln -s ${OBS_DIR}/S5P_NRTI_L2__${species}_* .
    else
      echo "NO TROPOMI FILES, exiting"
   fi
fi
#-------------------------------------------------------------------------------------
# Get the list of sites for this species
if [[ ${site} -eq 1 ]]; then
  rm -f sitefile.txt
  if [[ "${platform}" == "aeronet" ]]; then
    python ${scriptsdir}/site_analysis_aeronet.py ${species} > sitefile.txt
  elif [[ "${platform}" == "airnow" ]]; then
    python ${scriptsdir}/site_analysis_airnow.py ${species} > sitefile.txt
  elif [[ "${platform}" == "ish" ]] ||  [[ "${platform}" == "ish-lite" ]]; then
    python ${scriptsdir}/site_analysis_ish.py ${species} > sitefile.txt
  elif [[ "${platform}" == "openaq" ]]; then
    python ${scriptsdir}/site_analysis_openaq.py ${species} > sitefile.txt
  fi
  readarray -t site_list < sitefile.txt
  nsite=${#site_list[@]}
  mv sitefile.txt ${OBS_DIR}/sitefile.txt.${species}.${platform}.${todays_date}
fi
ndomains=$((${np}+${nsite}))
#-------------------------------------------------------------------------------------
#build array of region choices to go into control.yaml as RGN_list
# For statellites, need to select "Global" 
if [ ${CONUS} -eq 1 ]; then
  if [[ ${plot_type} -eq "ts_regional" ]]; then
    if [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then 
      rgn_list[0]="'Global'"
      rgn_type[0]="'all'"
    else
      rgn_list[0]="'CONUS'"
      rgn_type[0]="'isinconus'"
    fi
  fi
fi
#-------------------------------------------------------------------------------------
# Add the EPA regions if it is an AIRNOW variable -- TODO -- create RX regions for ISH/ASOS 
if [[ ${platform} =~ "airnow" ]]; then # No EPA Regions for AERONET
for r in $(seq 1 10)
do
    key="R${r}"
    eval do_region='$'$key
    if [ ${do_region} -eq 1 ]; then
      if [ ${#rgn_list[@]} -eq 0 ]; then
         rgn_list[0]="'$key'"
         rgn_type[0]="'epa_region'"
       else
         rgn_list[ ${#rgn_list[@]} +1 ]=",'$key'"
         rgn_type[ ${#rgn_type[@]} +1 ]=",'epa_region'"
      fi
    fi
done
fi
#-------------------------------------------------------------------------------------
#add the sites to the region list
if [[ ${site} -eq 1 ]];  then
  echo "Adding plots/stats for sites"
  for isite in $( seq 0 $(((${nsite} - 1))) )
  do
    if [ ${#rgn_list[@]} -eq 0 ]; then
      rgn_list[0]="${site_list[$isite]}"
      if [[ ${platform} == "airnow" ]]; then
        rgn_type[0]="'site'"
      else
        rgn_type[0]="'siteid'"
      fi
    else
      rgn_list[ ${#rgn_list[@]} +1 ]=",${site_list[$isite]}"
      if [[ ${platform} == "airnow" ]]; then
        rgn_type[ ${#rgn_type[@]} +1 ]=",'site'"
      else
        rgn_type[ ${#rgn_type[@]} +1 ]=",'siteid'"
      fi
    fi
   done
fi
#-------------------------------------------------------------------------------------
####################################################
####################################################
####################################################
####################################################
####################################################
# ... Construct the control.yaml file/namelist
echo "Bulding control.yaml"
YAML=tmp.control.yaml.${species}.${todays_date}.${plot_type}
rm -f ${yaml}
#------------------------------------------------------------
# -- Common to all yaml files --- 
cat << EOF > ${YAML}
analysis:
  start_time: '${start_time_yaml}'
  end_time:  '${end_time_yaml}'    
  output_dir: ${output_directory}
  output_dir_save: ${output_directory}
  save:
    method: 'netcdf'
    prefix: ${start_time_yaml}
    data: 'all'
  debug: True
EOF
#
# - For satellites, we need to add other analysis keys and
#   set up the obs grid that we will regrid everything to
if [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then
cat << EOF >> ${YAML}
  time_interval: '24h'
  time_chunking_with_obs_gridding: True
  regrid: True
  target_grid: obs_grid

obs_grid:
  start_time: '${YYYY_ytday}-${MM_ytday}-${DD_ytday}'
  end_time:   '${YYYY_twodays}-${MM_twodays}-${DD_twodays}'
  ntime: 72
  nlat: 180
  nlon: 360
EOF
fi
#
# Now insert which model based on data availability and matching keyss
cat << EOF >> ${YAML}
model:
EOF
####################################################
knt=0
knt2=0
knt3=0
bb="tmp_list.${species}"
for ((i=1; i<=30; i++)); do
fieldlist+="f"${i}" "
done
#####f1=Number of Initial Time (Fixed)
#####f2=Model Name (Fixed)
#####f3=Model Type (Fixed)
#####f4-f30=Initial Time,Run Length,Relative Time,Color,Marker,Linestyle,model specie name,obs specie name
while IFS=" " read -r $fieldlist
do
  echo "Reading field list"
  ##########
  for ((j=1; j<=$f1; j++)); do
  #echo "JLS, j =  $j"
  n1=$(echo "$j" \+ 3 | bc)
  initime=$(eval "echo f${n1}")
  n2=$(echo "$f1" \+ $n1 | bc)
  runlen=$(eval "echo f${n2}")
  n3=$(echo "$f1" \+ $n2 | bc)
  relday=$(eval "echo f${n3}")
  n4=$(echo "$f1" \+ $n3 | bc)
  color2=$(eval "echo f${n4}")
  n5=$(echo "$f1" \+ $n4 | bc)
  marker2=$(eval "echo f${n5}")
  n6=$(echo "$f1" \+ $n5 | bc)
  linestyle2=$(eval "echo f${n6}")
  #n7=$(echo "$f1" \+ $n6 | bc)
  n7=$(echo "$f1" \* 6 \+ 4 | bc)
  modname=$(eval "echo f${n7}")
  n8=$(echo $n7 \+ 1 | bc)
  obsname=$(eval "echo f${n8}")
   
  YYYY=`${DATE} +%Y -d "${todays_date} - ${!relday} days"`
  MM=`${DATE} +%m -d "${todays_date} - ${!relday} days"`
  DD=`${DATE} +%d -d "${todays_date} - ${!relday} days"`
  start_time=${YYYY}${MM}${DD}${!initime}  
  
  datadir=/mnt/lfs5/BMC/rtwbl/melodies-monet/model_output/${f2}/${start_time}
  has_data=0
  missing=0

  # Some platforms/species will require a 3d file
  # that will be kept seperately from the 2d file for faster loading
  # Will need to add platforms, e.g., TEMPO
  echo "Checking for testfile"
  if [[ "${platform}" == "TROPOMI" ]]; then
    testfile=${datadir}/aqm3d_${f2}_${start_time}.nc
  else
    testfile=${datadir}/aqm_${f2}_${start_time}.nc
  fi
  if [[ ! -r ${testfile} ]]; then
    missing=$((${missing}+1))
  fi
####################################################

  if [[ ${missing} -gt ${tol_hours_missing} ]]; then
    echo "Missing ${missing} files for ${f2}, more than allowed (${tol_hours_missing}), not processing "${f2}" ${!initime}Z"
  else
    echo "Found sufficent files to process "${f2}" "${!initime}"Z, checking if variable exists"
    ncdump -hv ${!modname} ${testfile}
    if [[ $? -eq 0 ]]; then
      echo "File has variable..." 
      has_data=1
    else
      echo "Variable not found, excluding ${f2}"
      has_data=0
    fi
  fi
  ################
  #... Create model list arrays dependent on model choices 
  if [[ ${has_data} -eq 1 ]]; then    # if data exists
  mdl_list[0]=${f2}"_"${YYYY}${MM}${DD}"-"${!initime}"Z"
  # .. Observations ..
  obs_list[0]=${platform}
  # check that at least one model is being used 
  if [ ${#mdl_list[@]} -eq 0 ]; then
          echo "Model list empty, please choose at least one (e.g., rapchem)"
          exit 1
  elif [ ${#obs_list[@]} -eq 0 ]; then
          echo "Obs list empty, please choose at least one (e.g., airnow)"
          exit 1
  else
          echo "Proceeding using the obs: ${obs_list[*]} and models ${mdl_list[*]}"
  fi
  #
  # Construct obs-mdl pair for plot groups
  for iobs in ${obs_list[@]}; do
  for imdl in ${mdl_list[@]}; do
       if [ $knt -eq 0 ]; then
            obs_mdl_list[knt++]="'${iobs}_${imdl}'"
       else
            obs_mdl_list[knt++]=",'${iobs}_${imdl}'"
       fi
  done
  done
  mdl_list_save[knt2++]="${mdl_list[0]}"
  if [[ $knt3 -eq 0 ]]; then
     mdl_list_save_quotes[knt3++]="'${mdl_list[0]}'"
  else
     mdl_list_save_quotes[knt3++]=",'${mdl_list[0]}'"
  fi
  mdl_path_save[knt2++]="${testfile}"
###################################################################################################################
cat << EOF >> ${YAML}
  ${mdl_list}:
    files: ${testfile}
    mod_type: '${f3}'
EOF
if [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then
cat << EOF >> ${YAML}
    apply_ak: False
    regrid:
       base_grid: ${testfile}
       method: bilinear
EOF
fi
# Model specific options
if [[ ${f3} == "hrrr" ]] || [[ ${f3} == "wrfchem" ]];then
if ! [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then
cat << EOF >> ${YAML}
    mod_kwargs:
      surf_only_nc: True
EOF
fi
fi

#
if [[ ${f3} == "rrfs" ]] || [[ ${f3} == 'raqms' ]]; then
if ! [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then
cat << EOF >> ${YAML}
    mod_kwargs:
      surf_only: True
EOF
fi
fi
#
if [[ ${f3} == "rrfs" ]] && [[ "${species}" == "PM2.5" ]]; then
cat << EOF >> ${YAML}
      convert_pm25: False
EOF
fi
#
if [[ "${platform}" == "airnow" ]]; then
cat << EOF >> ${YAML}
    projection: None
EOF
fi

if ! [[ "${sat_platforms[*]}" =~ "${platform}" ]]; then
cat << EOF >> ${YAML}
    radius_of_influence: 12000 #meters
    mapping: #model species name : obs species name
EOF
else
cat << EOF >> ${YAML}
    mapping: #model species name : obs species name
EOF
fi
##
cat << EOF >> ${YAML}
      ${platform}:
EOF
##
if [[ "${platform}" == "MODIS_AQUA" ]];then
cat << EOF >> ${YAML}
        AOD550: AOD_550_Dark_Target_Deep_Blue_Combined  
EOF
elif [[ "${platform}" == "MODIS_TERRA" ]];then
cat << EOF >> ${YAML}
        AOD550: AOD_550_Dark_Target_Deep_Blue_Combined
EOF
else
cat << EOF >> ${YAML}
        ${!modname}: "${!obsname}"
EOF
fi
###
cat << EOF >> ${YAML}
    plot_kwargs: #Opt
      color: '${!color2}'
      marker: '${!marker2}'
      linestyle: '${!linestyle2}'
      markersize: 8
      linewidth: ${mdl_lw}
EOF

fi # end if data exist 
done #end j loop
done < ${bb} #end read loop
###################################################################################################################
#Observation Types 
if [[ "${platform}" == "aeronet" ]] || \
   [[ "${platform}" == "airnow" ]] || \
   [[ "${platform}" == "ish" ]] || \
   [[ "${platform}" == "ish-lite" ]] || \
   [[ "${platform}" == "openaq" ]]
then
cat << EOF >> ${YAML}

obs:
  ${platform}: # obs label
    filename: test5.nc
    obs_type: pt_sfc
EOF
echo "finished catting in obs title"
fi
#
#if [[ "${platform}" == "airnow" ]]; then
#cat << EOF >> ${YAML}
#    use_airnow: True
#EOF
#fi
#
echo "JLS, continuing outside of obs title"
if [[ "${platform}" == "MODIS_AQUA" ]]; then
cat << EOF >> ${YAML}
obs:
  MODIS_AQUA: # obs label
    filename: MYD04*
    sat_type: modis_l2
    obs_type: sat_swath_clm
    debug: False
    regrid:
       base_grid: MODIS_AQUA_interpolated.nc
       method: bilinear
EOF
fi
#
if [[ "${platform}" == "MODIS_TERRA" ]]; then
cat << EOF >> ${YAML}
obs:
  MODIS_AQUA: # obs label
    filename: MYD04*
    sat_type: modis_l2
    obs_type: sat_swath_clm
    debug: False
    regrid:
       base_grid: MODIS_TERRA_interpolated.nc
       method: bilinear
EOF
fi
#
#if [[ "${platform}" == "TROPOMI" ]]; then
#cat << EOF >> ${YAML}
#obs:
#  TropOMI:
#    filename: S5P_NRTI_L2__*.nc
#    obs_type: sat_swath_clm
#    sat_type: tropomi_l2
#    regrid:
#       base_grid: ${STATIC_DIR}/static_grid_1x1.nc
#       method: bilinear
#EOF 
#fi
#
cat << EOF >> ${YAML}
    variables:
EOF
###################################################################################################################
if [[ "${platform}" == "aeronet" ]] && [[ ${species} == "aod_550nm" ]]; then
vmin=0.01
vmax=2.00
cat << EOF >> ${YAML}
      aod_550nm:
        unit_scale: 1
        unit_scale_method: '*' # Multiply = '*' , Add = '+', subtract = '-', divide = '/'
        nan_value: -1.0 # Set this value to NaN
        ylabel_plot: 'Aeronet 550nm AOD' #Optional to set ylabel so can include units and/or instr etc.
        vmin_plot: ${vmin} #Opt Min for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vmax_plot: ${vmax} #1.0 #Opt Max for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vdiff_plot: 0.2 #Opt +/- range to use in bias plots. To apply to a plot, change restrict_yaxis = True.
        nlevels_plot: 14 #Opt number of levels used in colorbar for contourf plot.
EOF
fi
###################################################################################################################
echo "JLS, testing species PM2.5"
if [[ "${species}" == "PM2.5" ]]; then
   vmin="1.0"; vmax="200.0";
cat << EOF >> ${YAML}

      PM2.5:
        unit_scale: 1
        unit_scale_method: '*' # Multiply = '*' , Add = '+', subtract = '-', divide = '/'
        nan_value: -1.0 # Set this value to NaN
        #The obs_min, obs_max, and nan_values are set to NaN first and then the unit conversion is applied.
        ylabel_plot: 'PM2.5 (ug/m3)' #Optional to set ylabel so can include units and/or instr etc.
        ty_scale: 2.0 #Opt
        vmin_plot: ${vmin} #Opt Min for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vmax_plot: ${vmax} #Opt Max for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vdiff_plot: 15.0 #Opt +/- range to use in bias plots. To apply to a plot, change restrict_yaxis = True.
        nlevels_plot: 14 #Opt number of levels used in colorbar for contourf plot.

EOF
fi
###################################################################################################################
if [[ "${species}" == "PM10" ]]; then
   vmin="10.0"; vmax="1000.0";
cat << EOF >> ${YAML}

      PM10:
        unit_scale: 1
        unit_scale_method: '*' # Multiply = '*' , Add = '+', subtract = '-', divide = '/'
        #obs_min: 0 # set all values less than this value to NaN
        #obs_max: 100 # set all values greater than this value to NaN
        nan_value: -1.0 # Set this value to NaN
        #The obs_min, obs_max, and nan_values are set to NaN first and then the unit conversion is applied.
        ylabel_plot: 'PM10 (ug/m3)' #Optional to set ylabel so can include units and/or instr etc.
        ty_scale: 2.0 #Opt
        vmin_plot: ${vmin} #Opt Min for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vmax_plot: ${vmax} #Opt Max for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vdiff_plot: 15.0 #Opt +/- range to use in bias plots. To apply to a plot, change restrict_yaxis = True.
        nlevels_plot: 14 #Opt number of levels used in colorbar for contourf plot.

EOF
fi
###################################################################################################################
if [[ "${species}" == "OZONE" ]]; then
cat << EOF >> ${YAML}
      OZONE:
        unit_scale: 1 #Opt Scaling factor 
        unit_scale_method: '*' #Opt Multiply = '*' , Add = '+', subtract = '-', divide = '/'
        nan_value: -1.0 # Opt Set this value to NaN
        ylabel_plot: 'Ozone (ppbv)'
        vmin_plot: 15.0 #Opt Min for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vmax_plot: 55.0 #Opt Max for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vdiff_plot: 20.0 #Opt +/- range to use in bias plots. To apply to a plot, change restrict_yaxis = True.
        nlevels_plot: 21 #Opt number of levels used in colorbar for contourf plot.
EOF
fi
