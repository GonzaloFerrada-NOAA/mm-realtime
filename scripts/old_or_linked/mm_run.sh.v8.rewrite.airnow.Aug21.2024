        vmin_plot: 0.0 #Opt Min for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
        vmax_plot: 10.0 #Opt Max for y-axis during plotting. To apply to a plot, change restrict_yaxis = True.
EOF
fi
