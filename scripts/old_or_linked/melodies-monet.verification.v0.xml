<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE workflow [

<!-- SLURM submission info-->
<!ENTITY ACCOUNT "rtwbl"> 
<!ENTITY QUEUE "batch">

<!ENTITY PARTITION "kjet:vjet:xjet">
<!ENTITY PARTITION_SEND "service">
