  <metatask name="mm_folium">
  <var name="model_type">regional_smoke regional_chemistry global</var>
    <task name="mm_folium_#model_type#" cycledefs="12hr" maxtries="2">
      &JOIN_RESOURCES_SHORT;
      &RESERVATION;
      <command>&SCRIPTS_DIR;/mm_folium.sh</command>
      <cores>&JOIN_PROC;</cores>
      <jobname><cyclestr>mm_folium_@Y@m@d@H_#model_type#</cyclestr></jobname>
      <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_folium_@Y@m@d@H_#model_type#.log</cyclestr></join>
      <envar>
        <name>START_TIME</name>
        <value><cyclestr>@Y@m@d</cyclestr></value>
      </envar>
      <envar>
        <name>model_type</name>
        <value>#model_type#</value>
      </envar>
      <envar>
        <name>WORKDIR</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/@Y@m@d@H/run/#model_type#/</cyclestr></value>
      </envar>
      <envar>
        <name>OBSDIR</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/obs/@Y@m@d@H/</cyclestr></value>
      </envar>
      <envar>
        <name>SCRIPTS_DIR</name>
        <value>&SCRIPTS_DIR;</value>
      </envar>
      <envar>
        <name>PLOT_OUTPUT_DIR</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/plot_output/@Y@m@d@H/#model_type#/</cyclestr></value>
      </envar>
      <envar>
        <name>remove_old_converted_images</name>
        <value>1</value>
      </envar>
      <envar>
        <name>CONDA_DIR</name>
        <value>&CONDA_DIR;</value>
      </envar>
      <envar>
        <name>CONDA_ENV</name>
        <value>&CONDA_ENV_STABLE;</value>
      </envar>
      <dependency>
       <sh>&SCRIPTS_DIR;/task_list_files/check_task_completion.sh <cyclestr>@Y@m@d</cyclestr> &SCRIPTS_DIR; &LOG_DIR;</sh>
      </dependency>
    </task>
  </metatask>

  <metatask name="mm_build_plots">
  <var name="model_type">regional_smoke regional_chemistry global</var>
    <task name="mm_build_plots_#model_type#" cycledefs="12hr" maxtries="1">
      &JOIN_RESOURCES;
      &RESERVATION;
      <command>&SCRIPTS_DIR;/build_monet_plots.sh</command>
      <cores>&JOIN_PROC;</cores>
      <jobname><cyclestr>mm_build-plots_@Y@m@d@H_#model_type#</cyclestr></jobname>
      <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_build-plots_@Y@m@d@H_#model_type#.log</cyclestr></join>
      <envar>
        <name>model_type</name>
        <value>#model_type#</value>
      </envar>
      <envar>
        <name>START_TIME</name>
        <value><cyclestr>@Y@m@d</cyclestr></value>
      </envar>
      <envar>
        <name>basedir</name>
        <value>&MELODIES_MONET_DIR;/toweb/</value>
      </envar>
      <envar>
        <name>plotdir</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/plot_output/@Y@m@d@H/#model_type#/</cyclestr></value>
      </envar>
      <envar>
        <name>workdir</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/toweb/@Y@m@d00/all</cyclestr></value>
      </envar>
      <dependency>
        <taskdep task="mm_folium_#model_type#"/>
      </dependency>
    </task>
  </metatask>

  <metatask name="mm_build_plots_update">
  <var name="model_type">regional_smoke</var>
    <task name="mm_build_plots_update_#model_type#" cycledefs="12hr" maxtries="1">
      &JOIN_RESOURCES;
      &RESERVATION;
      <command>&SCRIPTS_DIR;/build_monet_plots.sh</command>
      <cores>&JOIN_PROC;</cores>
      <jobname><cyclestr>mm_build-plots_@Y@m@d@H_#model_type#</cyclestr></jobname>
      <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_build-plots_@Y@m@d@H_#model_type#.log</cyclestr></join>
      <envar>
        <name>model_type</name>
        <value>#model_type#</value>
      </envar>
      <envar>
        <name>START_TIME</name>
        <value><cyclestr>@Y@m@d</cyclestr></value>
      </envar>
      <dependency>
       <and>
        <taskdep task="mm_folium_#model_type#"/>
        <or>
          <taskdep state="Succeeded" task="mm_run_hourly_#model_type#_PM25"/>
          <taskdep state="Dead" task="mm_run_hourly_#model_type#_PM25"/>
        </or>
        <or>
          <taskdep state="Succeeded" task="mm_run_hourly_#model_type#_PM10"/>
          <taskdep state="Dead" task="mm_run_hourly_#model_type#_PM10"/>
        </or>
        <or>
          <taskdep state="Succeeded" task="mm_run_hourly_#model_type#_AOD550"/>
          <taskdep state="Dead" task="mm_run_hourly_#model_type#_AOD550"/>
        </or>
       </and>
      </dependency>
    </task>
  </metatask>
  
  <metatask name="mm_hpss_backup">
  <var name="model_type">regional_smoke regional_chemistry global</var>   
    <task name="mm_hpss_backup_#model_type#" cycledefs="12hr" maxtries="2">
      &RESERVATION_SEND;
      &JOIN_RESOURCES_SHORT;
      <command>&SCRIPTS_DIR;/backup_analysis_to_hpss.sh</command>
      <cores>&JOIN_PROC;</cores>
      <jobname><cyclestr>mm_hpss_backup_@Y@m@d@H_#model_type#</cyclestr></jobname>
      <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_hpss_backup_@Y@m@d@H_#model_type#.log</cyclestr></join>
      <envar>
        <name>model_type</name>
        <value>#model_type#</value>
      </envar>
      <envar>
        <name>DIRTOARCHIVE</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/toweb/@Y@m@d00/#model_type#</cyclestr></value>
      </envar>
      <envar>
        <name>DIRTOARCHIVE2</name>
        <value><cyclestr>&MELODIES_MONET_DIR;/plot_output/@Y@m@d@H/#model_type#</cyclestr></value>
      </envar>
      <envar>
        <name>START_TIME</name>
        <value><cyclestr>@Y@m@d</cyclestr></value>
      </envar>
      <dependency>
        <taskdep task="mm_build_plots_#model_type#"/>
      </dependency>
    </task>
  </metatask>

  <metatask name="mm_clean">
   <var name="model_type">regional_smoke regional_chemistry global</var>
    <task name="mm_clean_#model_type#" cycledefs="12hr" maxtries="2">
      &RESERVATION_SEND;
      &JOIN_RESOURCES_SHORT;
      <command>/misc/whome/role.rap-chem/scripts/melodies-monet/clean_model_data.sh</command>
      <cores>&JOIN_PROC;</cores>
      <jobname><cyclestr>mm_clean_@Y@m@d@H_#model_type#</cyclestr></jobname>
      <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_clean_@Y@m@d@H_#model_type#.log</cyclestr></join>
      <envar>
        <name>START_TIME</name>
        <value><cyclestr>@Y@m@d</cyclestr></value>
      </envar>
      <envar>
        <name>NUM_DAYS_TO_KEEP</name>
        <value>&NUM_ANALYSIS_KEEP;</value>
      </envar>
      <envar>
        <name>model_type</name>
        <value>#model_type#</value>
      </envar>
      <envar>
        <name>DELETE_MODELS</name>
        <value>1</value>
      </envar>
      <envar>
        <name>DELETE_RAW_PLOTS</name>
        <value>1</value>
      </envar>
      <envar>
        <name>DELETE_TOWEB_PLOTS</name>
        <value>1</value>
      </envar>
      <envar>
        <name>MODEL_OUTPUT_DIR</name>
        <value>&MELODIES_MONET_DIR;/model_output</value>
      </envar>
      <envar>
        <name>RAW_PLOT_DIR</name>
        <value>&MELODIES_MONET_DIR;/plot_output</value>
      </envar>
      <envar>
        <name>TOWEB_DIR</name>
        <value>&MELODIES_MONET_DIR;/toweb</value>
      </envar>
      <dependency>
          <taskdep task="mm_hpss_backup_#model_type#"/>
      </dependency>
    </task>
   </metatask>
</workflow> 
