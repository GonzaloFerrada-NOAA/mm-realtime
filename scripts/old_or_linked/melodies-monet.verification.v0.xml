      </envar>
      <envar>
        <name>processORcat</name>
        <value>0</value>
      </envar>
      <dependency>
        <datadep age="00:05:00">&RRFS_SD_B_DATADIR_GRIB2;/<cyclestr offset="24:00:00">@Y@m@d@H/</cyclestr>/postprd/rrfs.t<cyclestr>@H</cyclestr>z.prslev.f0#fcsthour#.grib2</datadep>
      </dependency>
    </task>
  </metatask>

    <task name="mm_rrfs-sd_B_concat" cycledefs="00hr,06hr,12hr,18hr" maxtries="1">
