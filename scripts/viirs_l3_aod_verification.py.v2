# Definitions for spatial plots
ps              = [[41.75, -113.0], [38.5, -97.0]] # Lambert projection centers
axl             = [[-5200, 5900, -2600, 4800], [-2550, 2550, -1700, 1700]] # Lambert axis limits
mapres          = ['m0', 'na1'] # Map resolution and level
metricsregion   = [[-170, -55, 20, 80], [-125, -67, 25, 50]] # Bounding boxes to calculate metrics

# Levels:
lev_aod         = np.concatenate([[0, 0.05, 0.1, 0.15], np.arange(2, 11) / 10.0, [1.2, 1.5, 2.0]])
lev_bias_pos    = np.concatenate([[0.05], np.arange(1, 7) / 10.0])
lev_bias        = np.sort(np.concatenate([-lev_bias_pos, lev_bias_pos]))

# Colormaps
cm1 = es.hue([227,227,227], [136,183,211], 5)
cm2 = es.hue([85,180,94],[251,232,135],[252,170,95],[242,114,69],[194,27,38],[135,27,87],[255,192,203], len(lev_aod) - 1 - 5)
cmap_aod = ListedColormap(np.vstack((cm1.colors, cm2.colors)))
cmap_bias = es.hue('pan', len(lev_bias) - 1)



def fractional_hour_to_datetime(t, base_date):
    """Converts fractional hours to a datetime object."""
    if not np.isfinite(t) or t < 0:
        return datetime(1900, 1, 1)
    return base_date + timedelta(milliseconds=int(round(t * 60 * 60 * 1000)))

def is_valid_viirs_file(filepath):
    """Returns True if filepath points to a real, usable VIIRS file."""
    return bool(filepath) and filepath.lower() != "none" and os.path.isfile(filepath)

def viirs_file_date(filepath, fallback_time):
    """Extracts the date from the VIIRS filename or falls back to initial time."""
    filename = os.path.basename(filepath)
    match = re.search(r'_(\d{8})(?:_[^.]+)?\.nc$', filename)
    if not match:
        return fallback_time.replace(hour=0, minute=0, second=0, microsecond=0)
    return datetime.strptime(match.group(1), "%Y%m%d")

def read_model_data(filepath):
    """Reads model data from a NetCDF file."""
    with nc.Dataset(filepath, 'r') as ds:
        time_vals = ds.variables['time'][:]
        # Convert unix seconds to datetime
        times = np.array([datetime.fromtimestamp(t) for t in time_vals])
        
        return {
            'lon': ds.variables['lon'][:],
            'lat': ds.variables['lat'][:],
            'time': times,
            'aod': ds.variables['AOD550'][:]
        }

def replace_bad_viirs_aod(aod):
    """Replaces invalid or negative AOD values with NaN."""
    aod[~np.isfinite(aod) | (aod < 0)] = np.nan
    return aod

def read_viirs_netcdf(filepath, initial_time):
    """Reads VIIRS NetCDF."""
    base_date = viirs_file_date(filepath, initial_time)
    
    with nc.Dataset(filepath, 'r') as ds:
        aod = ds.variables['AOD550'][:]
        aod = replace_bad_viirs_aod(aod)
        
        # Convert fractional UTC hours manually
        overpass_time = ds.variables['overpass_time'][:]
        v_frac_to_dt = np.vectorize(lambda t: fractional_hour_to_datetime(t, base_date))
        times = v_frac_to_dt(overpass_time)
        
        return {
            'lon': ds.variables['lon'][:],
            'lat': ds.variables['lat'][:],
            'time': times,
            'aod': aod
        }

def average_aod(*arrays):
    """Averages any number of AOD arrays, handling NaNs gracefully."""
    finite_masks = [np.isfinite(a) for a in arrays]
    count = sum(m.astype(np.int8) for m in finite_masks)
    total = sum(np.where(m, a, 0.0) for m, a in zip(finite_masks, arrays))
    return np.divide(total, count, out=np.full(arrays[0].shape, np.nan, dtype=float), where=count > 0)

def write_output_netcdf(filepath, lon, lat, model_mean, viirs_mean):
    """Writes the processed time-mean data to a NetCDF4 file."""
    with nc.Dataset(filepath, "w", format="NETCDF4") as ds:
        ds.createDimension("lon", len(lon))
        ds.createDimension("lat", len(lat))
        
        var_lon = ds.createVariable("lon", "f4", ("lon",))
        var_lon.long_name = "longitude"
        var_lon.units = "degrees_east"
        var_lon[:] = lon
        
        var_lat = ds.createVariable("lat", "f4", ("lat",))
        var_lat.long_name = "latitude"
        var_lat.units = "degrees_north"
        var_lat[:] = lat
        
        with warnings.catch_warnings():
            warnings.filterwarnings(
                "ignore",
                message="Setting the shape on a NumPy array has been deprecated.*",
                category=DeprecationWarning,
            )
            
            var_mod = ds.createVariable("aod_model", "f4", ("lat", "lon"), zlib=True, complevel=3, fill_value=np.nan)
            var_mod.long_name = "time-mean model aerosol optical depth"
            var_mod[:, :] = np.asarray(model_mean, dtype=np.float32)
            
            var_obs = ds.createVariable("aod_viirs", "f4", ("lat", "lon"), zlib=True, complevel=3, fill_value=np.nan)
            var_obs.long_name = "time-mean VIIRS aerosol optical depth"
            var_obs[:, :] = np.asarray(viirs_mean, dtype=np.float32)

def get_metrics(lon, lat, obs, model, R):
    lon2d, lat2d = np.meshgrid(lon, lat) #, indexing='ij')
    lon_f, lat_f = lon2d.ravel(), lat2d.ravel()
    obs_f, model_f = obs.ravel(), model.ravel()
    
    mask = (lon_f >= R[0]) & (lon_f <= R[1]) & (lat_f >= R[2]) & (lat_f <= R[3])
    
    return es.metrics(obs_f[mask], model_f[mask], np.cos(np.radians(lat_f[mask])))
    
def make_figure(lon, lat, obs, model, bias, ps, axl, mapres, lev_aod, lev_bias, cmap_aod, cmap_bias, M, ymd, viirs_label='VIIRS'):
    es.msg("NA VIIRS AOD")
    ax1 = plt.subplot(2, 3, 1)
    es.spatial(lon, lat, obs, Projection='lambert', Origin=ps[0], Levels=lev_aod,
               MapRes=mapres[0], Colormap=cmap_aod, GeoTicks='off', Colorbar='off', MapWidth=0.3)
    id1 = es.figid(f'{viirs_label} AOD', ax=ax1)

    es.msg("NA Model AOD")
    ax2 = plt.subplot(2, 3, 2)
    cb1, _ = es.spatial(lon, lat, model, Projection='lambert', Origin=ps[0], Levels=lev_aod,
                         MapRes=mapres[0], Colormap=cmap_aod, GeoTicks='off', MapWidth=0.3)
    id2 = es.figid('RRFS-SD AOD', ax=ax2)

    es.msg("NA Model Bias")
    ax3 = plt.subplot(2, 3, 3)
    cb2, _ = es.spatial(lon, lat, bias, Projection='lambert', Origin=ps[0], Levels=lev_bias,
                         MapRes=mapres[0], Colormap=cmap_bias, GeoTicks='off', MapWidth=0.3)
    id3 = es.figid('Bias: RRFS-SD - VIIRS', ax=ax3)
    mm1 = ax3.text(0.02, 0.01, '\n'.join(M[0].Text[2:]), va='bottom', transform=ax3.transAxes)

    # CONUS:
    es.msg("CONUS VIIRS AOD")
    ax4 = plt.subplot(2, 3, 4)
    es.spatial(lon, lat, obs, Projection='lambert', Origin=ps[1], Levels=lev_aod,
               MapRes=mapres[1], Colormap=cmap_aod, GeoTicks='off', Colorbar='off', MapWidth=0.3)

    es.msg("CONUS Model AOD")
    ax5 = plt.subplot(2, 3, 5)
    es.spatial(lon, lat, model, Projection='lambert', Origin=ps[1], Levels=lev_aod,
               MapRes=mapres[1], Colormap=cmap_aod, GeoTicks='off', Colorbar='off', MapWidth=0.3)

    es.msg("CONUS Model Bias")
    ax6 = plt.subplot(2, 3, 6)
    es.spatial(lon, lat, bias, Projection='lambert', Origin=ps[1], Levels=lev_bias,
               MapRes=mapres[1], Colormap=cmap_bias, GeoTicks='off', Colorbar='off', MapWidth=0.3)
    mm2 = ax6.text(0.02, 0.01, '\n'.join(M[1].Text[2:]), va='bottom', transform=ax6.transAxes)

    for ax in (ax3, ax6):
        ax.set_facecolor((0.8, 0.8, 0.8))

    for ax in (ax1, ax2, ax3):
        ax.set_xlim(axl[0][0], axl[0][1])
        ax.set_ylim(axl[0][2], axl[0][3])
    for ax in (ax4, ax5, ax6):
        ax.set_xlim(axl[1][0], axl[1][1])
        ax.set_ylim(axl[1][2], axl[1][3])
    for ax in (ax1, ax2, ax3, ax4, ax5, ax6):
        ax.set_xticks([])
        ax.set_yticks([])

    es.reorganizeaxes(2, 3, width=300, height=None, spacing_horiz=10, spacing_vert=10,
                       remove_tick_labels=True, margin=120)

    cb1 = es.reorganizecolorbar(cb1, 2, 3, 'bottom', proportion=0.96, extent_axes=[1, 2])
    cb2 = es.reorganizecolorbar(cb2, 2, 3, 'bottom', proportion=0.96, extent_axes=[3, 3])

    # plt.rcParams['font.family'] = 'Arial'
    cb1.ax.tick_params(labelsize=9.5)
    cb2.ax.tick_params(labelsize=9.5)
    # plt.setp([id1, id2, id3], fontsize=11, family='Arial')
    # plt.setp([mm1, mm2], fontsize=8, family='Menlo')
    plt.setp([id1, id2, id3], fontsize=11)
    plt.setp([mm1, mm2], fontsize=8)

    x0, y0, w, h = cb1.ax.get_position().bounds
    cb1.ax.set_position([x0, y0, w, 0.02])
    x0, y0, w, h = cb2.ax.get_position().bounds
    cb2.ax.set_position([x0, y0, w, 0.02])

    cb1_ticks = cb1.get_ticks()[1:-1]
    cb1_labels = [t.get_text() for t in cb1.ax.get_xticklabels()][1:-1]
    cb1.set_ticks(cb1_ticks)
    cb1.set_ticklabels(cb1_labels)

    cb2_ticks = cb2.get_ticks()[1:-1]
    cb2_labels = [t.get_text() for t in cb2.ax.get_xticklabels()][1:-1]
    cb2.set_ticks(cb2_ticks)
    cb2.set_ticklabels(cb2_labels)
    plt.setp(cb2.ax.get_xticklabels(), rotation=90)

    # ax2.text(0.5, 1.2, ymd, fontsize=13, family='Arial', transform=ax2.transAxes, ha='center')
    ax2.text(0.5, 1.2, ymd, fontsize=13, transform=ax2.transAxes, ha='center')

# =============================================================================
# Main Execution
# =============================================================================

if __name__ == "__main__":
    
    # Environment Variables
    MODEL_NAME = os.environ.get("MODEL_NAME", "RRFS-SD")
    FILE_MODEL = os.environ.get("FILE_MODEL", "None")
    FILE_NOAA20 = os.environ.get("FILE_NOAA20", "None")
    FILE_NOAA21 = os.environ.get("FILE_NOAA21", "None")
    FILE_SNPP = os.environ.get("FILE_SNPP", "None")
    FILE_OUT = os.environ.get("FILE_OUT", "aod_mean.nc")
    FILE_FIG = os.environ.get("FILE_FIG", "aod_mean.png")
    
    init_time_str = os.environ.get("INITIAL_TIME", "2026-07-12 00:00:00")
    initial_time = datetime.strptime(init_time_str, "%Y-%m-%d %H:%M:%S")
    ymd = initial_time.strftime('%Y-%m-%d')
    
    es.msg(f"MODEL_NAME={MODEL_NAME}")
    es.msg(f"FILE_MODEL={FILE_MODEL}")
    es.msg(f"FILE_NOAA20={FILE_NOAA20}")
    es.msg(f"FILE_NOAA21={FILE_NOAA21}")
    es.msg(f"FILE_SNPP={FILE_SNPP}")
    es.msg(f"FILE_FIG={FILE_FIG}")
    
    opt_save_netcdf = True
    opt_make_figure = True
    
    # 1) Open model data
    es.msg("Reading model data...")
    model = read_model_data(FILE_MODEL)
    
    # 2) Open VIIRS data (only the products whose file was actually provided)
    es.msg("Reading VIIRS data...")
    viirs_files = {'noaa20': FILE_NOAA20, 'noaa21': FILE_NOAA21, 'snpp': FILE_SNPP}
    viirs_data = {}
    for name, path in viirs_files.items():
        if is_valid_viirs_file(path):
            es.msg(f"  {name}: {path}")
            viirs_data[name] = read_viirs_netcdf(path, initial_time)
        else:
            es.msg(f"  {name}: not provided, skipping")

    if not viirs_data:
        raise RuntimeError("No valid VIIRS files were provided (FILE_NOAA20, FILE_NOAA21, FILE_SNPP).")

    viirs_display_names = {'snpp': 'SNPP', 'noaa20': 'NOAA20', 'noaa21': 'NOAA21'}
    viirs_label = 'VIIRS (' + '/'.join(viirs_display_names[name] for name in viirs_display_names if name in viirs_data) + ')'

    # Initialize accumulators
    shape_viirs = next(iter(viirs_data.values()))['aod'].shape
    shape_model = model['aod'].shape[1:] # Assuming (time, lat, lon)

    viirs_sum   = np.zeros(shape_viirs, dtype=float)
    viirs_count = np.zeros(shape_viirs, dtype=int)
    model_sum   = np.zeros(shape_model, dtype=float)
    model_count = np.zeros(shape_model, dtype=int)

    es.msg("Hourly merging...")
    for t in model['time'][:24]:
        t0 = t - timedelta(minutes=30)
        t1 = t + timedelta(minutes=29)

        idx_model  = (model['time'] >= t0)  & (model['time'] <= t1)

        # Model hour average
        with np.errstate(invalid='ignore'):
            model_aod_hour = np.nanmean(model['aod'][idx_model, :, :], axis=0)

        # VIIRS hour matrices (one per available product)
        viirs_aod_hours = []
        for data in viirs_data.values():
            idx = (data['time'] >= t0) & (data['time'] <= t1)
            aod_hour = np.full(shape_viirs, np.nan, dtype=np.float32)
            aod_hour[idx] = data['aod'][idx]
            viirs_aod_hours.append(aod_hour)

        viirs_aod_hour = average_aod(*viirs_aod_hours)

        # Valid accumulations
        valid_viirs = np.isfinite(viirs_aod_hour)
        viirs_sum[valid_viirs] += viirs_aod_hour[valid_viirs]
        viirs_count[valid_viirs] += 1
        
        # Map valid VIIRS spaces to Model spaces
        model_aod_hour_values = np.copy(model_aod_hour)
        model_aod_hour_values[~valid_viirs] = np.nan
        
        valid_model = np.isfinite(model_aod_hour_values)
        model_sum[valid_model] += model_aod_hour_values[valid_model]
        model_count[valid_model] += 1
        
    viirs_mean = np.full(shape_viirs, np.nan)
    model_mean = np.full(shape_model, np.nan)
    
    valid_viirs_mean = viirs_count > 0
    valid_model_mean = model_count > 0
    
    es.msg("Computing time-mean and model AOD fields...")
    viirs_mean[valid_viirs_mean] = viirs_sum[valid_viirs_mean] / viirs_count[valid_viirs_mean]
    model_mean[valid_model_mean] = model_sum[valid_model_mean] / model_count[valid_model_mean]
    bias_mean = model_mean - viirs_mean
    
    if opt_save_netcdf:
        es.msg("Saving NetCDF output...")
        write_output_netcdf(FILE_OUT, model['lon'], model['lat'], model_mean, viirs_mean)
        es.msg(f"Saved NetCDF output to {FILE_OUT}")
        
    if opt_make_figure:
        es.msg("Plotting...")
        
        M = [get_metrics(model['lon'], model['lat'], viirs_mean, model_mean, metricsregion[0]),
             get_metrics(model['lon'], model['lat'], viirs_mean, model_mean, metricsregion[1])]
        # M = 1
        
        make_figure(model['lon'], model['lat'], viirs_mean, model_mean, bias_mean, ps, axl, mapres, lev_aod, lev_bias, cmap_aod, cmap_bias, M, ymd, viirs_label=viirs_label)
        
        plt.gcf().savefig(FILE_FIG, bbox_inches='tight', dpi=200)
        plt.close('all')
        
    
