<workflow realtime="T" scheduler="slurm" cyclethrottle="30" cyclelifespan="5:00:00:00" taskthrottle="60">

    <log><cyclestr>&LOG_DIR;/workflow_melodies-monet.@Y@m@d@H.log</cyclestr></log>

    <cycledef activation_offset="36:00:00" group="00hr">00 00 * * * *</cycledef>
    <cycledef activation_offset="36:00:00" group="12hr">00 12 * * * *</cycledef>
    <!-- Start of smoke pre-processing tasks -->
    
    <metatask name="mm_rrfs-sd">
        <var name="group">01 02 03 04 05 06</var>
        <task name="mm_rrfs-sd_#group#" cycledefs="00hr,12hr" maxtries="1">
            &JOIN_RESOURCES_SHORTEST;
            &RESERVATION;

            <command>&SCRIPTS_DIR;/prep_rrfs-sd.sh</command>
            <cores>&JOIN_PROC;</cores>
            <jobname><cyclestr>mm_rrfs-sd_@Y@m@d@H_#group#</cyclestr></jobname>
            <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_rrfs-sd_#group#.log</cyclestr></join>

            <envar><name>MELODIES_MONET_DIR</name><value>&MELODIES_MONET_DIR;</value></envar>
            <envar><name>SCRIPTS_DIR</name><value>&SCRIPTS_DIR;</value></envar>
            <envar><name>START_TIME</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
            <envar><name>cycleHH</name><value><cyclestr>@H</cyclestr></value></envar>
            <envar><name>GROUP</name><value>#group#</value></envar>
            <envar><name>NGROUPS</name><value>6</value></envar>
            <envar><name>FCST_LENGTH_HOURS</name><value>72</value></envar>
            <envar><name>processORcat</name><value>0</value></envar>
            <envar><name>RRFS_SD_DATADIR_GRIB2</name><value>&RRFS_SD_DATADIR_GRIB2;</value></envar>

            <dependency>
            <and>
                <datadep age="00:05:00"><cyclestr>&RRFS_SD_DATADIR_GRIB2;/rrfs.@Y@m@d/@H/rrfs.t@Hz.2dfld.3km.f000.na.grib2</cyclestr></datadep>
                <datadep age="00:05:00"><cyclestr>&RRFS_SD_DATADIR_GRIB2;/rrfs.@Y@m@d/@H/rrfs.t@Hz.2dfld.3km.f048.na.grib2</cyclestr></datadep>
            </and>
            </dependency>
        </task>
    </metatask>
    
    <task name="mm_rrfs-sd_concat" cycledefs="00hr,12hr" maxtries="1">
        &JOIN_RESOURCES_SHORTEST;
        &RESERVATION;

        <command>&SCRIPTS_DIR;/prep_rrfs-sd.sh</command>
        <cores>&JOIN_PROC;</cores>
        <jobname><cyclestr>mm_rrfs-sd_@Y@m@d@H_cat</cyclestr></jobname>
        <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_rrfs-sd_cat.log</cyclestr></join>

