<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE workflow [

<!-- SLURM submission info-->
<!ENTITY ACCOUNT "acomp"> 
<!ENTITY QUEUE "batch">
<!ENTITY PARTITION "u1-compute">
<!ENTITY PARTITION_SEND "u1-service">

<!ENTITY RESERVATION '<partition>&PARTITION;</partition><queue>&QUEUE;</queue><account>&ACCOUNT;</account>'>
<!ENTITY RESERVATION_SEND '<native>--mail-type=NONE</native><queue>&QUEUE;</queue><account>&ACCOUNT;</account><partition>&PARTITION_SEND;</partition>'>
<!ENTITY RESERVATION_MEDMEM '<native>--mail-type=NONE</native><queue>&QUEUE;</queue><account>&ACCOUNT;</account><partition>&PARTITION;</partition>'>
<!ENTITY RESERVATION_BIGMEM '<native>--mail-type=NONE</native><queue>&QUEUE;</queue><account>&ACCOUNT;</account><partition>&PARTITION;</partition>'>

<!ENTITY JOIN_RESOURCES_LONG "<walltime>07:59:00</walltime><memory>180G</memory>">
<!ENTITY JOIN_RESOURCES "<walltime>08:00:00</walltime><memory>80G</memory>">
<!ENTITY JOIN_RESOURCES_SHORT "<walltime>04:00:00</walltime><memory>20G</memory>">
<!ENTITY JOIN_RESOURCES_SHORTER "<walltime>02:00:00</walltime><memory>20G</memory>">
<!ENTITY JOIN_RESOURCES_SHORTEST "<walltime>01:00:00</walltime><memory>20G</memory>">
<!ENTITY JOIN_RESOURCES_SHORTEST_BIGMEM "<walltime>01:00:00</walltime><memory>160G</memory>">
<!ENTITY JOIN_RESOURCES_MEDMEM "<walltime>01:59:00</walltime><memory>64G</memory>">
<!ENTITY JOIN_RESOURCES_BIGMEM "<walltime>07:00:00</walltime><memory>80G</memory>">
<!ENTITY JOIN_PROC "1">

<!ENTITY RRFS_SD_DATADIR_GRIB2 "/scratch3/BMC/acomp/Sudheer/Fire-nest/Retros/RRFS_A/RT/GRIB2">
<!ENTITY NAQFC_DATADIR "/NCEPPROD/hpssprod/runhistory/5year/">
<!ENTITY NAQFC_PARA6D_DIR "/NAGAPE/arl/5year/Patrick.C.Campbell/">
<!ENTITY MELODIES_MONET_DIR "/scratch3/BMC/acomp/Gonzalo.Ferrada/verif/realtime">
<!ENTITY LOG_DIR "&MELODIES_MONET_DIR;/logs/">
<!ENTITY PLOTDIR "&MELODIES_MONET_DIR;/plot_output/">
<!ENTITY SCRIPTS_DIR "&MELODIES_MONET_DIR;/scripts/">
<!ENTITY CONDA_ENV_STABLE "/scratch4/BMC/acomp/cheMPAS-Fire/envs/melodies-monet-nrt-vx">
<!ENTITY HMS_DATADIR "/scratch4/BMC/public/data/grids/nesdis/">

<!ENTITY NUM_ANALYSIS_KEEP "10">
]>

<workflow realtime="F" scheduler="slurm" cyclethrottle="30" taskthrottle="60">

    <log><cyclestr>&LOG_DIR;/workflow_melodies-monet.@Y@m@d@H.log</cyclestr></log>

    <cycledef group="monet">202608250000 202608250000 24:00:00</cycledef>
    <!-- Start of smoke pre-processing tasks -->

    <metatask name="send_rrfs-sd">
        <var name="group">01 02 03 04 05 06</var>
        <task name="mm_rrfs-sd_#group#" cycledefs="monet" maxtries="1">
            &JOIN_RESOURCES_SHORTEST;
            &RESERVATION;

            <command>&SCRIPTS_DIR;/prep_rrfs-sd.sh</command>
            <cores>&JOIN_PROC;</cores>
            <jobname><cyclestr>send_rrfs-sd_@Y@m@d@H_#group#</cyclestr></jobname>
            <join><cyclestr>&LOG_DIR;/@Y@m@d@H/send_rrfs-sd_#group#.log</cyclestr></join>

            <envar><name>MELODIES_MONET_DIR</name><value>&MELODIES_MONET_DIR;</value></envar>
            <envar><name>SCRIPTS_DIR</name><value>&SCRIPTS_DIR;</value></envar>
            <envar><name>START_TIME</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
            <envar><name>cycleHH</name><value><cyclestr>@H</cyclestr></value></envar>
            <envar><name>GROUP</name><value>#group#</value></envar>
            <envar><name>NGROUPS</name><value>6</value></envar>
            <envar><name>FCST_LENGTH_HOURS</name><value>48</value></envar>
            <envar><name>processORcat</name><value>0</value></envar>
            <envar><name>RRFS_SD_DATADIR_GRIB2</name><value>&RRFS_SD_DATADIR_GRIB2;</value></envar>

            <dependency>
            <and>
                <datadep age="00:05:00"><cyclestr>&RRFS_SD_DATADIR_GRIB2;/rrfs.@Y@m@d/@H/rrfs.t@Hz.2dfld.3km.f000.na.grib2</cyclestr></datadep>
                <datadep age="00:05:00"><cyclestr>&RRFS_SD_DATADIR_GRIB2;/rrfs.@Y@m@d/@H/rrfs.t@Hz.2dfld.3km.f048.na.grib2</cyclestr></datadep>
            </and>
            </dependency>
        </task>
    </metatask>
    
    <task name="mm_rrfs-sd_concat" cycledefs="monet" maxtries="1">
        &JOIN_RESOURCES_SHORTEST;
        &RESERVATION;

        <command>&SCRIPTS_DIR;/prep_rrfs-sd.sh</command>
        <cores>&JOIN_PROC;</cores>
        <jobname><cyclestr>mm_rrfs-sd_@Y@m@d@H_cat</cyclestr></jobname>
        <join><cyclestr>&LOG_DIR;/@Y@m@d@H/mm_rrfs-sd_cat.log</cyclestr></join>

        <envar><name>MELODIES_MONET_DIR</name><value>&MELODIES_MONET_DIR;</value></envar>
        <envar><name>SCRIPTS_DIR</name><value>&SCRIPTS_DIR;</value></envar>
        <envar><name>START_TIME</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
        <envar><name>cycleHH</name><value><cyclestr>@H</cyclestr></value></envar>
        <envar><name>processORcat</name><value>1</value></envar>

        <dependency>
            <metataskdep metatask="send_rrfs-sd"/>
        </dependency>
    </task>
    
</workflow> 
